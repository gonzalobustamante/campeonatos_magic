@model ErrorViewModel
@{ ViewData["Title"] = "Ocurrió un problema"; }
<section class="empty"><h1>No pudimos completar la acción.</h1><p>Vuelve a intentarlo. Si el problema persiste, entrega este identificador al administrador:</p><code>@Model.RequestId</code><p><a class="button" asp-controller="Home" asp-action="Index">Volver al inicio</a></p></section>
